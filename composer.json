{
    "name": "marcorieser/tailwind-merge-statamic",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "MarcoRieser\\TailwindMergeStatamic\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MarcoRieser\\TailwindMergeStatamic\\Tests\\": "tests"
        }
    },
    "require": {
        "laravel/framework": "^11.0 || ^12.0 || ^13.0",
        "marcorieser/tailwind-merge-laravel": "^0.1.0",
        "statamic/cms": "^5.0|^6.0"
    },
    "require-dev": {
        "laravel/pint": "^1.21",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "Tailwind Merge Statamic",
            "description": "Automatically resolves Tailwind CSS class conflicts in Statamic"
        },
        "laravel": {
            "providers": [
                "MarcoRieser\\TailwindMergeStatamic\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
